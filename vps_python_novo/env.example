# Copie para ".env" na mesma pasta e preencha. NUNCA envie o .env para ninguem.
# Chave VPS gerada na plataforma Win or Win (comeca com wowvps_). Pode deixar vazio
# para digitar na hora (a digitacao nao aparece na tela).
WOW_VPS_TOKEN=
WOW_RELAY_URL=https://win-or-win.lovable.app/api/public/topstep-vps/observacoes/
MT5_TERMINAL=C:\Program Files\Fotmarkets MT5 Terminal\terminal64.exe
# TopstepX:MT5 separados por virgula
MAPA_SIMBOLOS=MGC:GOLD,MNQ:US100Cash
MT5_MAGIC=26110225
MT5_DEVIATION=30
CARD_MAX_AGE_MS=20000
POSITION_MAX_AGE_MS=8000
CLOCK_MAX_DRIFT_MS=5000
POLL_MS=700
